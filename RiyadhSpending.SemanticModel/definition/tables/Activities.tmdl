	partition Activities = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "activities.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Activity", type text}, {"Category", type text}, {"Level", type text}, {"WeekEnding", type date}, {"Transactions", Int64.Type}, {"ValueSAR", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
